package com.gis.service;

import com.gis.model.Node;
import com.gis.model.NodeState;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.messaging.simp.SimpMessagingTemplate;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;

import java.time.LocalDateTime;
import java.util.List;
import java.util.Random;

@Slf4j
@Service
@RequiredArgsConstructor
public class SimulationService {
    
    private final NodeService nodeService;
    private final SimpMessagingTemplate messagingTemplate;
    private final Random random = new Random();
    
    @Scheduled(fixedDelay = 1000)
    public void simulateNodeUpdates() {
        try {
            List<Node> nodes = nodeService.getAllNodes();
            if (nodes.isEmpty()) return;
            
            // Simulate up to 500 nodes per second
            int simulationCount = Math.min(500, nodes.size());
            for (int i = 0; i < simulationCount; i++) {
                Node node = nodes.get(random.nextInt(nodes.size()));
                simulateNode(node);
            }
        } catch (Exception e) {
            log.error("Error in simulation: {}", e.getMessage());
        }
    }
    
    private void simulateNode(Node node) {
        // Update power (random fluctuation)
        double powerChange = (random.nextDouble() - 0.5) * 10;
        double newPower = Math.max(0, node.getPowerOutput() + powerChange);
        node.setPowerOutput(newPower);
        
        // Update battery (random fluctuation)
        double batteryChange = (random.nextDouble() - 0.5) * 2;
        double newBattery = Math.max(0, Math.min(100, node.getBatteryLevel() + batteryChange));
        node.setBatteryLevel(newBattery);
        
        // Random state changes (2% chance)
        if (random.nextDouble() < 0.02) {
            NodeState[] states = NodeState.values();
            NodeState newState = states[random.nextInt(states.length)];
            node.setState(newState);
            node.setFault(newState == NodeState.FAULT);
            
            // Broadcast state change
            String message = String.format("%s → %s", node.getNodeId(), newState);
            messagingTemplate.convertAndSend("/topic/events", message);
            
            log.info("State change: {}", message);
        }
        
        node.setLastUpdate(LocalDateTime.now());
        nodeService.updateNode(node);
        
        // Send update to WebSocket
        messagingTemplate.convertAndSend("/topic/nodes", node);
    }
    
    @Scheduled(fixedDelay = 5000)
    public void broadcastStats() {
        try {
            var stats = nodeService.getStats();
            messagingTemplate.convertAndSend("/topic/stats", stats);
            log.debug("Stats broadcasted: {}", stats);
        } catch (Exception e) {
            log.error("Error broadcasting stats: {}", e.getMessage());
        }
    }
}